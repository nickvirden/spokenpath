{
  "name": "spokenpath-workspace",
  "version": "0.6.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint:commits": "node scripts/lint-commits.mjs",
    "lint:json": "node -e \"['./package.json', './.releaserc.json', './.github/release/package.json'].forEach((file) => require(file))\"",
    "lint:hooks": "shellcheck .husky/commit-msg .husky/pre-commit",
    "lint:workflows": "actionlint",
    "zizmor": "zizmor .",
    "test:release": "node --test --test-isolation=none .github/release/test/version-rules.test.mjs",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "lint:biome": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "deny": "cargo deny check",
    "test:rust": "cargo test --workspace --locked",
    "test:node": "pnpm -r --filter '!@spokenpath/capture-chromium' --filter '!spokenpath' test",
    "test:capture": "pnpm --filter @spokenpath/capture-chromium test",
    "test:e2e": "cargo build --locked -p spokenpath_cli && pnpm --filter spokenpath test",
    "spokenpath": "cargo build --quiet --locked -p spokenpath_cli && node packages/cli/src/cli.ts",
    "test:versions": "node --test scripts/test/set-version.test.mjs",
    "check": "pnpm lint:commits && pnpm lint:json && pnpm lint:hooks && pnpm lint:workflows && pnpm zizmor && pnpm test:release && pnpm lint:rust && pnpm lint:biome && pnpm typecheck && pnpm deny && pnpm test:rust && pnpm test:node && pnpm test:capture && pnpm test:e2e && pnpm test:versions",
    "test:safari": "pnpm --filter @spokenpath/capture-safari test:live"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
