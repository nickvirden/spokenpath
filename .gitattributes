* text=auto eol=lf

# Fixture pages are byte-exact: the torture pages' CRLF line endings, BOM and non-UTF-8
# bytes are what the tests exercise, and every capture golden records its page's SHA-256,
# so git never normalises them.
fixtures/pages/** -text

